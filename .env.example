NEXT_PUBLIC_SITE_URL=https://cloverloop.in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_CLOVERLOOP_INSTAGRAM_URL=https://www.instagram.com/cloverloop.in
NEXT_PUBLIC_CLOVERLOOP_YOUTUBE_URL=https://www.youtube.com/@cloverloopin
NEXT_PUBLIC_CLOVERLOOP_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61596271502595
NEXT_PUBLIC_CLOVERLOOP_THREADS_URL=https://www.threads.net/@cloverloop.in
NEXT_PUBLIC_CLOVERLOOP_LINKEDIN_URL=https://www.linkedin.com/company/cloverloop
NEXT_PUBLIC_CLOVERLOOP_X_URL=https://x.com/cloverloopin
NEXT_PUBLIC_CLOVERLOOP_TIKTOK_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: enable Resend delivery-status callbacks.
RESEND_WEBHOOK_SECRET=
PURCHASE_DOWNLOAD_LINK_SECRET=
CRON_SECRET=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Set the client and webhook values to match the selected mode in each Vercel environment.
# Prefer per-environment values. The legacy OAuth and partner webhook values below
# remain ZERO_FEE-only fallbacks for existing deployments.
RAZORPAY_ZERO_FEE_TEST_CLIENT_ID=
RAZORPAY_ZERO_FEE_TEST_CLIENT_SECRET=
RAZORPAY_ZERO_FEE_TEST_WEBHOOK_SECRET=
RAZORPAY_ZERO_FEE_LIVE_CLIENT_ID=
RAZORPAY_ZERO_FEE_LIVE_CLIENT_SECRET=
RAZORPAY_ZERO_FEE_LIVE_WEBHOOK_SECRET=
RAZORPAY_FOUR_PERCENT_TEST_CLIENT_ID=
RAZORPAY_FOUR_PERCENT_TEST_CLIENT_SECRET=
RAZORPAY_FOUR_PERCENT_TEST_WEBHOOK_SECRET=
RAZORPAY_FOUR_PERCENT_LIVE_CLIENT_ID=
RAZORPAY_FOUR_PERCENT_LIVE_CLIENT_SECRET=
RAZORPAY_FOUR_PERCENT_LIVE_WEBHOOK_SECRET=
# Required for Creator commission authorization email; use an approved Razorpay contact.
RAZORPAY_PARTNERSHIPS_EMAIL=
# Optional additional CC; the creator is always copied.
RAZORPAY_PARTNERSHIPS_CC_EMAIL=
# Optional recipient for terminal authorization-email delivery failure alerts.
RAZORPAY_COMMISSION_EMAIL_ALERT_TO=
# Legacy ZERO_FEE-only compatibility values; retain until migration is verified.
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_MODE=test
RAZORPAY_TOKEN_ENCRYPTION_KEY=
# In Live mode, true enables checkout for all buyers.
RAZORPAY_CHECKOUT_ENABLED=false
RAZORPAY_PARTNER_WEBHOOK_SECRET=
# Product reviews: HMAC secret (32+ characters) for single-use review links.
REVIEW_TOKEN_SECRET=
# Set to true only after testing; the review-invitations cron does nothing otherwise.
REVIEW_INVITATIONS_ENABLED=false
# Optional: invitations sent per cron run (default 25, max 100), throttled to under 2 per second.
REVIEW_INVITATION_BATCH_SIZE=25
